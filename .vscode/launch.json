{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Samsung OneUI: server.js",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on\\s+(https?://[^\\s]+)",
        "uriFormat": "%s"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Samsung OneUI: Chrome (3000, 서버 먼저)",
      "url": "http://127.0.0.1:3000/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
